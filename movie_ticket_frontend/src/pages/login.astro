---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <section style="max-width:400px;margin:0 auto;">
    <div class="card">
      <h1 style="margin-bottom:2rem;">Sign In</h1>
      <form method="POST" action="/api/login">
        <label for="email" style="font-weight:500;margin-bottom:.5rem;display:block;">Email</label>
        <input name="email" type="email" placeholder="you@email.com" required style="width:100%;margin-bottom:1rem;" />
        <label for="password" style="font-weight:500;margin-bottom:.5rem;display:block;">Password</label>
        <input name="password" type="password" required style="width:100%;margin-bottom:1rem;" />
        <button type="submit" style="width:100%;margin-bottom:.8rem;">Login</button>
      </form>
      <div style="margin-top:1rem;text-align:center;">
        <span>New? </span><a href="/register" style="color:var(--color-accent);">Create account</a>
      </div>
    </div>
  </section>
</Layout>

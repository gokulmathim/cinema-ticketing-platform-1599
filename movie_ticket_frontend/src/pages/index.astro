---
import Layout from '../layouts/Layout.astro';
import { movies } from '../mock/movies';
// movies is a placeholder; data will later come from backend API.

const nowShowing = movies.filter(m => m.status === "now-showing");
const upcoming = movies.filter(m => m.status === "upcoming");
---

<Layout>
  <section style="margin-bottom:2rem;">
    <h1 style="margin-bottom: .5rem;">Now Showing</h1>
    <form style="display:flex;gap:1rem;flex-wrap:wrap;margin-bottom:1.2rem;">
      <input type="search" name="q" placeholder="Search movies..." style="width:18rem;" />
      <select name="genre" style="width:12rem;">
        <option value="">All Genres</option>
        <option>Action</option>
        <option>Comedy</option>
        <option>Drama</option>
        <option>Thriller</option>
        <option>Sci-Fi</option>
      </select>
    </form>
    <div style="display:flex;gap:1.6rem;flex-wrap:wrap;">
      {nowShowing.map(movie => (
        <a href={`/movies/${movie.id}`} class="card" style="width:210px;text-align:left;box-shadow:var(--shadow);padding:1rem;display:block;transition:box-shadow .2s;">
          <img src={movie.poster} alt={movie.title} style="width:100%;border-radius:var(--radius);margin-bottom:.5rem;" />
          <div style="font-weight:bold;font-size:1.1rem">{movie.title}</div>
          <div style="color:var(--color-accent);font-size:.93rem">{movie.genre}</div>
          <div style="color:var(--color-text);font-size:.91rem">{movie.duration} min</div>
        </a>
      ))}
    </div>
  </section>

  <section style="margin-bottom:2rem;">
    <h2 style="margin-bottom:.5rem;">Upcoming Movies</h2>
    <div style="display:flex;gap:1.6rem;flex-wrap:wrap;">
      {upcoming.map(movie => (
        <a href={`/movies/${movie.id}`} class="card" style="width:210px;text-align:left;box-shadow:var(--shadow);padding:1rem;display:block;">
          <img src={movie.poster} alt={movie.title} style="width:100%;border-radius:var(--radius);margin-bottom:.5rem;" />
          <div style="font-weight:bold;font-size:1.1rem">{movie.title}</div>
          <div style="color:var(--color-secondary);font-size:.93rem">{movie.genre}</div>
          <div style="color:var(--color-text);font-size:.91rem">{movie.duration} min</div>
        </a>
      ))}
    </div>
  </section>
</Layout>
